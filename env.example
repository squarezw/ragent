DATABASE_URL=postgresql://postgres:CHANGEME@YOUR_DB_SERVER:5432/ragent
JWT_SECRET=YOUR_JWT_SECRET
# JWT Token 过期时间（默认: 7d，支持格式: 1h, 1d, 7d, 30d 等）
JWT_EXPIRES_IN=7d
EXTERNAL_API_BASE_URL=http://localhost:8010

# kkFileView 预览服务地址（浏览器访问，必须是公网可访问的地址）
# 注：仅用于浏览器侧文件预览；服务端 docx→PDF 转换已改走 OnlyOffice（见下方 ONLYOFFICE_INTERNAL_URL）
KKFILEVIEW_BASE_URL=http://localhost:8012

# kkFileView 内部地址（容器内访问，走 Docker 网络服务名）
# - 本地开发: http://localhost:8012
# - Docker 部署: http://kkfileview:8012
# - 若 kkFileView 配了 KK_CONTEXT_PATH（如 /kkpreview），这里也要带上：http://kkfileview:8012/kkpreview
KKFILEVIEW_INTERNAL_URL=http://kkfileview:8012

# 提供给 kkFileView 访问本应用的基础 URL（kkFileView 容器内访问 Next.js 服务）
# - 本地开发: http://localhost:3000
# - Docker 部署: http://web:3000 （Docker 内部服务名）
FILE_PREVIEW_BASE_URL=http://localhost:3000

# PDF 生成服务地址
# - 本地开发: http://localhost:3005
# - Docker 部署: http://markdown-to-pdf:3000
PDF_SERVICE_URL=http://markdown-to-pdf:3000

# Subscription Agent 服务配置
SUBSCRIPTION_AGENT_API_URL=https://subscription-agent.example.com
SUBSCRIPTION_AGENT_API_KEY=your-api-key

# 用户注册邀请码（用于公开注册功能）
REGISTRATION_INVITE_CODE=your-invite-code-here

# Cron Job 配置（定时任务调度器）
ENABLE_CRON=true

# OSS 对象存储服务（ragent-oss）
OSS_SERVICE_URL=http://localhost:3010
OSS_API_KEY=ragent-oss-secret

# 流程管理服务 (zn-process-management)
PROCESS_MGMT_BASE_URL=http://localhost:8030
# 租户ID到公司代码映射 (格式: company_code-tenant_id, 冒号分隔)
# 用于OA审批流程中解析oa_userid (ZSH→6, ZFZ→5)
ZN_TENANT_MAPPING=zsh-1:zfz-2
# 超级管理员调用流程管理手册接口时的默认租户 code（用于解析叶子部门）
# 普通用户/租户管理员使用 users.tenant_id；超管账号无 tenant_id，fallback 到此处
ZN_DEFAULT_TENANT_CODE=ZSH
# OA审批通过后自动上传到知识库的目标 dataset 映射 (格式: company_code-dataset_id, 冒号分隔)
ZN_KB_DATASET_MAP=zsh-00000000-0000-0000-0000-000000000000:zfz-00000000-0000-0000-0000-000000000000

# OnlyOffice Document Server
# - 浏览器访问地址（前端加载编辑器 UI）
NEXT_PUBLIC_ONLYOFFICE_URL=http://localhost:8443
# - Docker 内部地址（Next.js 服务端访问 OnlyOffice：在线编辑 + docx→PDF 转换都走这里，必填）
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
# - JWT 密钥（与 OnlyOffice 容器共享）
ONLYOFFICE_JWT_SECRET=onlyoffice-dev-secret

# 登录页底部 ICP 备案号（留空则不渲染该行）
ICP_NUMBER=
