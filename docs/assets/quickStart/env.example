# ========================================
# PostgreSQL 数据库配置
# ========================================
PGUSER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=ragent
EXPOSE_POSTGRES_PORT=5432
HOST=postgres  # Docker环境使用服务名；本地开发可改为IP

# 数据库卷挂载路径（Docker部署使用）
PGDATA_HOST_VOLUME=./data/postgres
INIT_SQL_VOLUME=./db

# SQLAlchemy 配置
SQLALCHEMY_POOL_SIZE=30
SQLALCHEMY_POOL_RECYCLE=1800  # 30分钟回收连接，避免超时（降低自3600）
SQLALCHEMY_ECHO=false

# ========================================
# Redis 配置
# ========================================
REDIS_HOST=redis  # Docker环境使用服务名；本地开发可改为localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_DECODE_RESPONSES=true

# Redis Docker 配置
EXPOSE_REDIS_PORT=6379
REDIS_MAX_MEMORY=256mb
REDIS_DATA_VOLUME=./data/redis

# ========================================
# Neo4j 配置
# ========================================
NEO4J_URI=bolt://neo4j:7687  # Docker环境使用服务名；本地开发可改为bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
EXPOSE_NEO4J_HTTP_PORT=7474
EXPOSE_NEO4J_BOLT_PORT=7687
NEO4J_HEAP_SIZE=512M
NEO4J_PAGECACHE_SIZE=512M

# Neo4j Docker 配置
NEO4J_DATA_VOLUME=./data/neo4j/data
NEO4J_LOGS_VOLUME=./data/neo4j/logs
NEO4J_IMPORT_VOLUME=./data/neo4j/import
NEO4J_PLUGINS_VOLUME=./data/neo4j/plugins

# 应用配置
APP_NAME=Ragent Service
DEBUG=true

# API 配置
API_V1_PREFIX=/api/v1 

# JWT签名密钥（与前端保持一致）
JWT_SECRET_KEY=ragent_secret
# JWT过期时间（秒），默认7天
JWT_EXPIRES_IN=604800

# 用户注册配置
# 注册邀请码，为空则禁用注册功能
REGISTRATION_INVITE_CODE=your_invite_code

# 防暴力破解配置（基于Redis）
# 登录接口 - IP限制
LOGIN_RATE_LIMIT_IP=10                # 每个IP在时间窗口内最大登录尝试次数
LOGIN_RATE_LIMIT_IP_WINDOW=900        # IP限制时间窗口（秒），默认15分钟
# 登录接口 - 用户名限制
LOGIN_RATE_LIMIT_USER=5               # 每个用户名在时间窗口内最大失败次数
LOGIN_RATE_LIMIT_USER_WINDOW=900      # 用户名限制时间窗口（秒），默认15分钟
# 注册接口 - IP限制
REGISTER_RATE_LIMIT_IP=5              # 每个IP在时间窗口内最大注册尝试次数
REGISTER_RATE_LIMIT_IP_WINDOW=3600    # 注册IP限制时间窗口（秒），默认1小时

# DeepSeek
DEEPSEEK_API_KEY=your_api_key
# 可选：deepseek-v4-pro / deepseek-v4-flash（不设置时默认 deepseek-v4-flash）
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TEMPERATURE=0.7

# 本地模型配置
USE_LOCAL_MODEL=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# 微信配置
WECHAT_TOKEN=your_token
WECHAT_ENCODING_AES_KEY=your_aes_key
WECHAT_CORP_ID=YourCorpId

# 企业微信 OAuth 走 wecom-gateway 托管式（webhook 推送模型）：ragent 当网关下游、不暴露公网——
# 把自己的内网 webhook 地址告诉网关，网关换完 userinfo 后 POST 推回
# /api/v1/wechat/oauth/gateway-callback，ragent 据此绑定。用 OAuth 绑定则以下四项必填
# （缺失时首次调 /oauth/authorize 才报错，不在启动期强制）。
# WECOM_GATEWAY_API_KEY 是密钥，请放 ~/.ragent_profile，勿提交进仓库。
WECOM_GATEWAY_BASE_URL=
WECOM_GATEWAY_API_KEY=
WECOM_GATEWAY_AGENT_ID=
WECOM_GATEWAY_WEBHOOK_URL=

# 入站走网关：网关收企微回调、解密后以 HMAC 签名 POST 到本服务 /api/v1/wechat/gateway-incoming。
# 切换为整体硬切（企微后台回调 URL 改指网关，不可灰度）；回退把回调 URL 指回 ragent 自身的 /api/v1/wechat/。
# WECOM_GATEWAY_HMAC_SECRET 用于校验网关投递签名（onboard 随 api-key 签发），配了入站订阅就必填；放 ~/.ragent_profile。
WECOM_GATEWAY_HMAC_SECRET=

# 出站灰度开关：true 时发消息/传素材/查 agent 走 wecom-gateway（出站凭证收口到网关），
# false（默认）仍直连企微 cgi。开 true 仅需 WECOM_GATEWAY_BASE_URL + WECOM_GATEWAY_API_KEY
# （agent_id 逐条消息传，不依赖上面的 WECOM_GATEWAY_AGENT_ID）。随时翻回可回退。
WECOM_OUTBOUND_VIA_GATEWAY=false

# 企业微信多应用配置
# 配置文件路径（支持相对路径和绝对路径，默认为 wechat_agents.json）
# 配置文件必须包含 default_agent_id 和 agents 列表
# 如果文件不存在，企微功能会被禁用（不会阻止程序启动）
WECHAT_AGENTS_CONFIG_FILE=wechat_agents.json

# OpenAI Embedding 配置
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_URL_PROXY=your_embedding_url_proxy

# Tokenizers配置 - 禁用并行化以避免fork警告
TOKENIZERS_PARALLELISM=false

# 文件存储配置
FILE_STORAGE_PREFIX=/app/uploads  # Docker环境；本地开发可改为绝对路径

# HuggingFace 缓存目录（用于挂载模型缓存）
HUGGINGFACE_CACHE_DIR=/home/ubuntu/.cache/huggingface

# ModelScope 缓存目录（Fun-ASR 等模型）
MODELSCOPE_CACHE_DIR=/home/ubuntu/.cache/modelscope

# Doc2X 远程解析配置
DOC2X_API_KEY=your_api_key  # Doc2X API密钥
DOC2X_MAX_PAGES=10  # 最大处理页数
DOC2X_THREAD_COUNT=1  # 线程数
DOC2X_TIMEOUT=300  # 超时时间（秒）
DOC2X_DEBUG=false  # 是否开启调试模式

# 阿里云百炼配置
ALIYUN_API_KEY=your_aliyun_api_key  # 阿里云百炼API密钥
RERANK_MODEL=gte-rerank-v2  # 重排序模型名称


# URL参数加密配置
# 用于加密反馈链接等敏感URL参数
URL_CRYPTO_SECRET=your-secret-key-change-in-production

# 反馈链接基础URL
# 用于生成反馈链接，根据不同环境配置不同的域名
FEEDBACK_BASE_URL=https://ragent.mouqitech.com/public/feedback
FILE_DOWNLOAD_BASE_URL=https://ragent.mouqitech.com/api/uploads

# 微信消息配置
# 微信消息最大内容长度，超过此长度不添加反馈按钮（避免消息被截断）
WECHAT_MAX_CONTENT_LENGTH=2000

# 反馈邮箱配置
# 反馈邮件默认接收邮箱，当app_email为空时使用
FEEDBACK_EMAIL=feedback@example.com

# 工具执行结果 webhook（可选；URL、TOOL_WEBHOOK_TOOLS、TOOL_WEBHOOK_TOKEN 均配置后 middleware 才注册）
# TOOL_WEBHOOK_TOOLS：逗号分隔，与 agent 调用的 tool_call name 精确匹配
# TOOL_WEBHOOK_PLATFORMS：逗号分隔，与 apps.platform 精确匹配（如 Web）
TOOL_WEBHOOK_URL=
TOOL_WEBHOOK_TOKEN=
TOOL_WEBHOOK_TOOLS=
TOOL_WEBHOOK_PLATFORMS=Web
TOOL_WEBHOOK_TIMEOUT_SECS=10

# 预审过程日志上报（纯日志通路；失败不阻断预审）
RAGENT_LOGS_URL=http://192.168.80.3:13001/ragent/logs
RAGENT_CALLBACK_TOKEN=
RAGENT_LOGS_TIMEOUT_SECS=5

# OCR 高级服务配置（DeepSeek OCR）
# DeepSeek OCR 容器服务地址
OCR_ADVANCED_BASE_URL=http://deepseek-ocr-api:3030
# OCR 请求超时时间（秒），默认 600 秒（10 分钟）
OCR_ADVANCED_TIMEOUT=600

# 用户信息 API IP 白名单配置
# 只有白名单中的 IP 可以访问 /api/v1/user/internal 接口
# 多个 IP 用逗号分隔，例如: USER_API_ALLOWED_IPS=192.168.1.100,10.0.0.1,127.0.0.1
# 留空表示不限制（不推荐生产环境）
USER_API_ALLOWED_IPS=192.168.1.100,127.0.0.1

# Internal API Access Token 配置
# 用于访问 /api/v1/user/internal 接口的访问令牌
# TODO: 后续可以改为从数据库或更安全的认证方式
INTERNAL_API_ACCESS_TOKEN=your_access_token_here

# LangSmith
LANGSMITH_TRACING=true                    # 启用追踪
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_smith_api_key
LANGSMITH_PROJECT=your_smith_project
RAG_API_BASE_URL=http://localhost:8010
RAG_API_TOKEN=your_rag_api_token

QCC_COOKIE=your_QCC_Cookie
# 标招招平台 Cookie
BZZ_COOKIE=your_BZZ_Cookie

# OSS 对象存储配置
OSS_SERVICE_URL=http://localhost:3000
OSS_API_KEY=your_oss_api_key

# ========================================
# License 校验（本地开发用，生产不需要填）
# ========================================
# 先跑 `make dev-license` 生成 dev license，再填这三个绝对路径。
# RAGENT_LICENSE_PATH=/absolute/path/to/.dev-license.lic
# RAGENT_MACHINE_ID_PATH=/absolute/path/to/.dev-machine-id
# RAGENT_LICENSE_STATE_PATH=/tmp/ragent-license-state.json

# ── 原生工具（app/tools/native_registry.py）──
#
# 这个部署不要哪些原生工具，逗号分隔。留空 = 全都按代码里的授权判据生效。
#
# **这里只表达部署偏好，不是安全边界。** 每个原生工具的授权判据写死在代码里
# （sql_query 仅超级管理员、search_knowledge_base 需该 app 绑了数据集……），
# 所以少写一个名字不会造成越权；写错的名字会在日志里报 ERROR 而不是静默忽略。
#
# 可用名字：sql_query / send_email / search_knowledge_base / get_company_info
#           / get_stock_price / get_file_download_url
# NATIVE_TOOLS_DISABLED=sql_query

# 知识库检索参数（原先在 tools 表那行的 default_config 里）。
# 默认值逐字取自原库配置——注意 chat_utils 的内建 fallback 是 0.7 / False，与之不同，
# 照 fallback 走会让召回骤降、智能选库被关掉。
# KB_SEARCH_TOP_K=5
# KB_SEARCH_SIMILARITY_THRESHOLD=0.4
# KB_SEARCH_AUTO_SELECT=true
# KB_SEARCH_RERANK_ENABLED=false
# KB_SEARCH_RERANK_TOP_N=3
# KB_SEARCH_TIMEOUT=30

# ── MCP 工具的密钥（可选）──
#
# 默认不需要在这里配。迁移 044 预置的 mcp-search-tavily 把密钥写成占位值
# `your-api-key`，在「工具管理」里替换即可（占位值状态下该工具不注册，日志会点名）。
#
# 只有当你**不想让密钥进数据库**时才用这里：把工具配置里的值写成 `${TAVILY_API_KEY}`，
# 解析时会从进程环境变量取。数据库备份和工具详情接口就都看不到密钥了。
# TAVILY_API_KEY=

# ── Skill 沙箱的目录根（容器化部署必配）──
#
# ragent-service 若自己跑在容器里，`docker run -v A:B` 的 A 由**宿主机** daemon 解释。
# 默认值（/tmp/ragent-skill-work、~/.ragent/...）只存在于本容器的可写层，宿主机上没有
# ——daemon 会现建同名空目录，于是 skill 挂到空的 /skill（拿不到自己的脚本）、产物落进
# 谁也读不到的孤儿目录，**全程不报错**。
#
# 所以容器化部署必须把这三个根换到从宿主机 bind mount 进来的路径，且两侧同路径
# （compose 的 volumes 已按下面这三个值写好）。配错时 execute_skill 会当场报错拒跑，
# 不会静默降级。
#
# 裸机/开发机直接跑 python 的话不用配，保持默认即可。
# SKILL_WORK_BASE=/var/lib/ragent/skill/work
# SKILL_MATERIALIZE_BASE=/var/lib/ragent/skill/materialize
# SKILL_STATE_BASE=/var/lib/ragent/skill/state
#
# 宿主目录不在宿主机根文件系统上（例如挂在独立盘的 /data）时，自动翻译会少前缀，
# 用这个显式指定，逗号分隔，前缀匹配：
# SKILL_HOST_PATH_MAP=/var/lib/ragent/skill:/data/ragent/skill

# ── Skill 产物投递（默认开，需已配 OSS）──
#
# 运行结束把**本次新产生的**产物传到对象存储，返回签名下载链接给模型，让它把链接
# 交给用户。在此之前输出里只有宿主机绝对路径，用户点不开——文件生成了却送不到手上。
#
# 没配 OSS（oss_service_url / oss_api_key 为空）时整段自动不做，输出与从前逐字一致。
# SKILL_ARTIFACT_DELIVERY=true          # 配了 OSS 但暂时不想投递就设 false
# SKILL_ARTIFACT_MAX_FILES=10           # 单次最多投递几个（超出的会列出并说明原因）
# SKILL_ARTIFACT_MAX_MB=25              # 单文件上限
# SKILL_ARTIFACT_URL_TTL_SEC=86400      # 链接有效期；这个数字会写进给用户的提示里

# ── Skill 渐进披露（默认开）──
#
# 绑定 skill 的正文默认全量注入 system prompt。超过触发线（>5 个 skill 或约 >8k token）
# 时自动降级：只注入每个 skill 的 name + description，正文改由 `load_skill(name)`
# 按需读取。**没超线的应用一切照旧**——绑 1~5 个精选 skill 的常规应用零变化。
#
# 设成 false 则永远全量注入（回滚旋钮：降级会改变送进 LLM 的 system prompt）。
# SKILL_PROGRESSIVE_DISCLOSURE=true
